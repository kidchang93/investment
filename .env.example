# ── 한국투자증권 오픈API 자격증명 ─────────────────────────────
# KIS Developers(https://apiportal.koreainvestment.com)에서 발급받은 값
KIS_APP_KEY=여기에_appkey
KIS_APP_SECRET=여기에_appsecret

# ── 실행 환경 ────────────────────────────────────────────────
# vts  = 모의투자 (openapivts / ws ops:31000)
# prod = 실전투자 (openapi   / ws ops:21000)
APP_ENV=prod

# 백엔드 REST/WS 포트
PORT=4000

# 모니터링 종목 (선택). 비우면 backend/src/watchlist.ts 기본값 사용
# 형식: "종목코드:종목명" 쉼표 구분
# WATCHLIST=005930:삼성전자,000660:SK하이닉스,035420:NAVER
